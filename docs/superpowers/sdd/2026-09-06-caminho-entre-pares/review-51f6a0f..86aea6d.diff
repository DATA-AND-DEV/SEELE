+/// já avaliado esconderia dentro do chamador justamente a decisão que este
+/// guarda existe para prender.
+fn locais_a_publicar<F: FnOnce() -> Vec<SocketAddr>>(
+    emprestando: bool,
+    todos: F,
+) -> Vec<SocketAddr> {
+    if emprestando {
+        todos()
+    } else {
+        Vec::new()
+    }
+}
