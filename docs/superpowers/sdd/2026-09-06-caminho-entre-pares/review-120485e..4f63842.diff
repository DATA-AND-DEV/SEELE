+/// O cenário inteiro montado: servidor, quem compartilha, quem empresta, quem
+/// assiste, e a transmissão no ar chegando aos dois pelo servidor.
+struct Cenario {
+    servidor: Arc<Daemon>,
+    compartilha: Par,
+    empresta: Enlace,
+    assiste: Enlace,
+    screen: ScreenId,
+    copias: ContadorDeCopias,
+}
