+            eventos
+                .iter()
+                .any(|linha| linha.starts_with("WARN") && linha.contains("nenhum quadro-chave")),
+            "o canal fechou sem chave nenhuma atravessar, e nenhum WARN foi ao rastro: {eventos:?}"
+        );
+    }
