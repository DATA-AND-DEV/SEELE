+            "10.0.0.1:9",
+            "172.16.0.1:9",
+            "192.168.1.10:9",
+            "169.254.7.7:9",
+            "[::1]:9",
+            "[fd00::1]:9",
+            "[fe80::1]:9",
+            "[febf:ffff::1]:9",
+        ] {
+            assert_eq!(
+                como_chegou(texto.parse().unwrap()),
+                ComoChegou::Local,
+                "{texto} é da mesma rede e foi contado como furo"
+            );
+        }
+        for texto in ["203.0.113.5:9", "[2001:db8::1]:9"] {
+            assert_eq!(
+                como_chegou(texto.parse().unwrap()),
+                ComoChegou::Furo,
+                "{texto} não é da rede local"
