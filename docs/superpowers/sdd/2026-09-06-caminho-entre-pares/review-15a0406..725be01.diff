+        let abertura = vec![9_u8; seele_proto::screen::SCREEN_HEADER_LEN];
+        let abertura_clone = abertura.clone();
+        let (manda, recebe) = tokio::sync::mpsc::channel(8);
+        let repassando =
+            tokio::spawn(async move { repassar(&ligado, &abertura_clone, recebe).await });
