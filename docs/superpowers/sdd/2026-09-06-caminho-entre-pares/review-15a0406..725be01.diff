+                // deram em nada. Sem `ParFalhou` daqui: é quem assiste que vai
+                // notar a falta de imagem e avisar o servidor.
+                None => tracing::info!(
+                    ?screen,
+                    "nenhuma das duas tentativas de servir este par deu certo"
+                ),
+            }
