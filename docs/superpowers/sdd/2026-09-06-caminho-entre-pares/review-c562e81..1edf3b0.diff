+                            "caminho entre pares recebido antes de o despacho existir"
+                        );
+                    }
+
                     // The handshake is over. Repeating it is a protocol
                     // violation, not a re-authentication.
                     ClientMessage::Response { .. } | ClientMessage::Hello { .. } => break,
                 }
             }
 
