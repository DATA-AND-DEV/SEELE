+        );
+        assert_eq!(
+            serde_json::to_value(Fronteira::NaoSabe).unwrap(),
+            serde_json::json!({ "tipo": "nao_sabe" })
+        );
+        assert_eq!(
+            serde_json::to_value(Fronteira::Mesma { linha: "1".into() }).unwrap(),
+            serde_json::json!({ "tipo": "mesma", "linha": "1" })
+        );
+        for (texto, escolha) in [
+            ("\"cancelar\"", Escolha::Cancelar),
+            ("\"adiar\"", Escolha::Adiar),
+            ("\"prosseguir\"", Escolha::Prosseguir),
+        ] {
+            assert_eq!(serde_json::from_str::<Escolha>(texto).unwrap(), escolha);
+        }
+    }
+}
diff --git a/apps/seele-app/src/copia_do_banco.rs b/apps/seele-app/src/copia_do_banco.rs
new file mode 100644
index 00000000..9a0457f0
--- /dev/null
+++ b/apps/seele-app/src/copia_do_banco.rs
@@ -0,0 +1,298 @@
+//! **A cópia de segurança verificada, antes de converter o banco** (backport
+//! 0.16.x; a mesma regra do `antes_de_hospedar::preparar_copia` da 0.17, sem o
+//! resto daquela tela).
+//!
+//! Na 0.16.0, escolher ATUALIZAR ou DESLIGAR para um MOD de API antiga abria o
+//! banco do servidor com `Persistence::open` — que **migra** — no próprio
+//! clique, sem cópia nenhuma do estado de antes. Daqui em diante quem converte
+//! é só o botão final das saídas (`mods::aplicar_saidas_dos_mods_antigos`), e
+//! ele passa por [`preparar`] antes: sem a cópia pronta e conferida, nada é
+//! convertido.
+//!
+//! # A regra
+//!
+//! 1. Lê o esquema gravado, só para leitura. Sem esquema legível, não copia.
+//! 2. Toma a **trava** do banco (`BEGIN IMMEDIATE` numa conexão própria): nenhum
+//!    outro escritor até a verificação; as leituras continuam.
+//! 3. Conta as linhas de cada tabela da fonte, sob a trava.
+//! 4. Escreve a cópia num nome provisório com `VACUUM INTO`, de uma conexão só
+//!    de leitura (que vê o que está no WAL).
+//! 5. Verifica: `PRAGMA integrity_check` igual a `ok`, as mesmas tabelas com as
+//!    mesmas contagens e o mesmo esquema da fonte.
+//! 6. Só então dá o nome final (`copias-de-seguranca/<servidor>/esquema-<n>-<ms>.db`,
+//!    o mesmo lugar e o mesmo nome que a 0.17 lista), e solta a trava sem
+//!    escrever nada.
+//!
+//! Uma cópia que não passa é apagada, e o erro diz a etapa. O banco original
+//! não é tocado em nenhum caminho deste arquivo.
+
+use std::path::{Path, PathBuf};
+
+/// A pasta das cópias de segurança, dentro da pasta de dados do SEELE. O mesmo
+/// nome da 0.17 (`antes_de_hospedar::PASTA_DAS_COPIAS`).
+pub(crate) const PASTA_DAS_COPIAS: &str = "copias-de-seguranca";
+
+/// A pasta das cópias de um servidor.
+pub(crate) fn pasta_das_copias(config: &Path, servidor: Option<&str>) -> PathBuf {
+    config
+        .join(PASTA_DAS_COPIAS)
+        .join(servidor.unwrap_or("padrao"))
+}
+
+/// O esquema gravado, lido só para leitura. `Err` quando não se lê.
+fn esquema_de(banco: &Path) -> Result<i64, String> {
+    let conexao = rusqlite::Connection::open_with_flags(
+        banco,
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|erro| erro.to_string())?;
+    let tem_a_tabela: i64 = conexao
+        .query_row(
+            "SELECT count(*) FROM sqlite_master WHERE type = 'table' AND name = 'schema_version'",
+            [],
+            |linha| linha.get(0),
+        )
+        .map_err(|erro| erro.to_string())?;
+    if tem_a_tabela == 0 {
+        return Ok(0);
+    }
+    conexao
+        .query_row(
+            "SELECT COALESCE(MAX(version), 0) FROM schema_version",
+            [],
+            |linha| linha.get(0),
+        )
+        .map_err(|erro| erro.to_string())
+}
+
+/// Quantas linhas cada tabela tem, por nome, em ordem: a régua com que a cópia
+/// é comparada à fonte.
+fn contagem_por_tabela(banco: &rusqlite::Connection) -> Result<Vec<(String, i64)>, String> {
+    let mut consulta = banco
+        .prepare(
+            "SELECT name FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' \
+             ORDER BY name",
+        )
+        .map_err(|erro| erro.to_string())?;
+    let nomes: Vec<String> = consulta
+        .query_map([], |linha| linha.get(0))
+        .map_err(|erro| erro.to_string())?
+        .collect::<Result<_, _>>()
+        .map_err(|erro| erro.to_string())?;
+    nomes
+        .into_iter()
+        .map(|nome| {
+            let citado = nome.replace('"', "\"\"");
+            banco
+                .query_row(&format!("SELECT count(*) FROM \"{citado}\""), [], |linha| {
+                    linha.get::<_, i64>(0)
+                })
+                .map(|n| (nome, n))
+                .map_err(|erro| erro.to_string())
+        })
+        .collect()
+}
+
+/// **Cria e verifica uma cópia do estado atual de `banco`.** Devolve o caminho
+/// da cópia pronta.
+///
+/// # Errors
+///
+/// A etapa e o motivo, em texto. Nada foi convertido, e não sobra cópia
+/// provisória.
+pub(crate) fn preparar(
+    config: &Path,
+    servidor: Option<&str>,
+    banco: &Path,
+) -> Result<PathBuf, String> {
+    preparar_com(config, servidor, banco, |_| {})
+}
+
+/// [`preparar`] com o que acontece entre escrever e verificar, para o teste
+/// estragar a cópia.
+pub(crate) fn preparar_com(
+    config: &Path,
+    servidor: Option<&str>,
+    banco: &Path,
+    depois_de_escrever: impl FnOnce(&Path),
+) -> Result<PathBuf, String> {
+    // 1. O esquema.
+    let esquema = esquema_de(banco).map_err(|motivo| format!("conferir: {motivo}"))?;
+
+    // 2. A trava.
+    let trava = rusqlite::Connection::open_with_flags(
+        banco,
+        rusqlite::OpenFlags::SQLITE_OPEN_READ_WRITE | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    )
+    .map_err(|erro| format!("copiar: {erro}"))?;
+    trava
+        .busy_timeout(std::time::Duration::from_secs(2))
+        .map_err(|erro| format!("copiar: {erro}"))?;
+    // `IMMEDIATE`, e não `EXCLUSIVE`: os dois barram outro escritor, mas o
+    // `EXCLUSIVE` também barra leitores no diário tradicional, e aí o
+    // `VACUUM INTO` (um leitor) não leria (medido na 0.17: «database is locked»).
+    trava
+        .execute_batch("BEGIN IMMEDIATE")
+        .map_err(|erro| format!("copiar: o banco está em uso: {erro}"))?;
+
+    // 3. A régua da fonte.
+    let da_fonte = contagem_por_tabela(&trava).map_err(|motivo| format!("copiar: {motivo}"))?;
+
+    let pasta = pasta_das_copias(config, servidor);
+    std::fs::create_dir_all(&pasta).map_err(|erro| format!("copiar: {erro}"))?;
+    let agora_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_or(0, |desde| desde.as_millis());
+    let final_ = pasta.join(format!("esquema-{esquema}-{agora_ms}.db"));
+    let provisoria = pasta.join(format!(".escrevendo-{esquema}-{agora_ms}.db"));
+    let _ = std::fs::remove_file(&provisoria);
+
+    // 4. A cópia.
+    let escrever = || -> Result<(), String> {
+        let origem = rusqlite::Connection::open_with_flags(
+            banco,
+            rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+        )
+        .map_err(|erro| erro.to_string())?;
+        origem
+            .execute("VACUUM INTO ?1", [provisoria.display().to_string()])
+            .map_err(|erro| erro.to_string())?;
+        Ok(())
+    };
+    if let Err(motivo) = escrever() {
+        let _ = std::fs::remove_file(&provisoria);
+        return Err(format!("copiar: {motivo}"));
+    }
+    depois_de_escrever(&provisoria);
+
+    // 5. A verificação, contra a fonte.
+    let verificar = || -> Result<(), String> {
+        let copia = rusqlite::Connection::open_with_flags(
+            &provisoria,
+            rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+        )
+        .map_err(|erro| erro.to_string())?;
+        let integridade: String = copia
+            .query_row("PRAGMA integrity_check", [], |linha| linha.get(0))
+            .map_err(|erro| erro.to_string())?;
+        if integridade != "ok" {
+            return Err(format!("integrity_check: {integridade}"));
+        }
+        let da_copia = contagem_por_tabela(&copia)?;
+        if da_copia != da_fonte {
+            return Err(format!(
+                "a cópia não tem o conteúdo da fonte: fonte {da_fonte:?}, cópia {da_copia:?}"
+            ));
+        }
+        drop(copia);
+        match esquema_de(&provisoria) {
+            Ok(n) if n == esquema => Ok(()),
+            outro => Err(format!(
+                "a cópia não tem o esquema da origem ({esquema}): {outro:?}"
+            )),
+        }
+    };
+    if let Err(motivo) = verificar() {
+        let _ = std::fs::remove_file(&provisoria);
+        return Err(format!("verificar: {motivo}"));
+    }
+
+    // 6. O nome final, e a trava sai sem escrever nada.
+    std::fs::rename(&provisoria, &final_).map_err(|erro| {
+        let _ = std::fs::remove_file(&provisoria);
+        format!("copiar: {erro}")
+    })?;
+    let _ = trava.execute_batch("ROLLBACK");
+    drop(trava);
+    tracing::info!(
+        banco = %banco.display(),
+        copia = %final_.display(),
+        esquema,
+        "cópia de segurança do banco feita e conferida contra a fonte antes de converter"
+    );
+    Ok(final_)
+}
+
+#[cfg(test)]
+mod testes {
+    #![allow(clippy::unwrap_used, clippy::expect_used)]
+
+    use super::{preparar, preparar_com, PASTA_DAS_COPIAS};
+    use std::path::Path;
+
+    fn banco_no_esquema(caminho: &Path, n: i64) {
+        let banco = rusqlite::Connection::open(caminho).unwrap();
+        banco
+            .execute_batch(
+                "CREATE TABLE schema_version (version INTEGER NOT NULL);
+                 CREATE TABLE coisa (x INTEGER);
+                 INSERT INTO coisa VALUES (42);",
+            )
+            .unwrap();
+        banco
+            .execute("INSERT INTO schema_version VALUES (?1)", [n])
+            .unwrap();
+    }
+
+    /// A cópia sai inteira, no esquema da fonte, com o conteúdo dela, e a fonte
+    /// fica byte a byte como estava.
+    #[test]
+    fn a_copia_sai_conferida_e_a_fonte_nao_muda() {
+        let dir = tempfile::tempdir().unwrap();
+        let banco = dir.path().join("seele.db");
+        banco_no_esquema(&banco, 13);
+        let antes = std::fs::read(&banco).unwrap();
+
+        let copia = preparar(dir.path(), None, &banco).unwrap();
+
+        assert!(copia.starts_with(dir.path().join(PASTA_DAS_COPIAS).join("padrao")));
+        assert!(copia
+            .file_name()
+            .unwrap()
+            .to_string_lossy()
+            .starts_with("esquema-13-"));
+        let lido: i64 = rusqlite::Connection::open(&copia)
+            .unwrap()
+            .query_row("SELECT x FROM coisa", [], |l| l.get(0))
+            .unwrap();
+        assert_eq!(lido, 42);
+        assert_eq!(
+            std::fs::read(&banco).unwrap(),
+            antes,
+            "copiar mexeu na fonte"
+        );
+    }
+
+    /// Uma cópia estragada entre escrever e verificar não passa, e não fica.
+    #[test]
+    fn uma_copia_estragada_nao_passa_e_nao_fica() {
+        let dir = tempfile::tempdir().unwrap();
+        let banco = dir.path().join("seele.db");
+        banco_no_esquema(&banco, 13);
+        let falha = preparar_com(dir.path(), None, &banco, |provisoria| {
+            rusqlite::Connection::open(provisoria)
+                .unwrap()
+                .execute("DELETE FROM coisa", [])
+                .unwrap();
+        })
+        .unwrap_err();
+        assert!(falha.starts_with("verificar:"), "{falha}");
+        let sobrou: Vec<_> = std::fs::read_dir(dir.path().join(PASTA_DAS_COPIAS).join("padrao"))
+            .unwrap()
+            .collect();
+        assert!(
+            sobrou.is_empty(),
+            "a cópia que não passou ficou: {sobrou:?}"
+        );
+    }
+
+    /// Um arquivo que não é banco não é copiado.
+    #[test]
+    fn um_arquivo_que_nao_e_banco_nao_e_copiado() {
+        let dir = tempfile::tempdir().unwrap();
+        let banco = dir.path().join("seele.db");
+        std::fs::write(&banco, b"isto nao e um banco sqlite, e nem finge ser").unwrap();
+        let falha = preparar(dir.path(), None, &banco).unwrap_err();
+        assert!(falha.starts_with("conferir:"), "{falha}");
+    }
+}
