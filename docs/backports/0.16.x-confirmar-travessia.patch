--- /dev/null
+++ b/apps/seele-app/bancada/travessia-de-versao.cjs
@@ -0,0 +1,233 @@
+// **A confirmação antes de atualizar para outra versão do servidor** (backport
+// 0.16.x do E4 da 0.17). Com o HTML, o CSS e a `tela-server.js` reais; só a
+// ponte nativa é simulada, e a `VersaoNova` simulada tem a forma que o Rust
+// manda (`atualizador::Fronteira` serializada com `tipo`).
+//
+// # O que ela mede
+//
+// 1. **Da 0.16 para a 0.17** (Servidor 1.0 → 2.0): o painel diz, antes do
+//    botão, que a versão fala outra versão do servidor; INSTALAR abre a camada
+//    `#travessia` (alertdialog, modal, foco em CANCELAR) e **não** chama
+//    `instalar_atualizacao`.
+// 2. **Cancelar** chama `escolher_atualizacao` com «cancelar», não instala, e diz
+//    que nada foi baixado. Escape e o clique fora cancelam do mesmo jeito, e o
+//    Escape não fecha a configuração atrás.
+// 3. **Adiar** chama `escolher_atualizacao` com «adiar», não instala; uma oferta
+//    já adiada diz isso na camada.
+// 4. **Prosseguir** chama `instalar_atualizacao` com `confirmada` = a versão
+//    mostrada, e só então.
+// 5. **Mesma versão do servidor** (0.16.0 → 0.16.1): nenhuma camada, nenhuma
+//    frase de travessia, e `instalar_atualizacao` com `confirmada: null`.
+// 6. **A recusa do Rust** (`TravessiaNaoConfirmada`) é dita e deixa a oferta
+//    na tela, para confirmar de novo.
+// 7. **Sem a versão do servidor no manifesto** (`nao_sabe`) também pede a
+//    confirmação.
+//
+// Rodar:  node apps/seele-app/bancada/travessia-de-versao.cjs [pasta-das-capturas]
+
+const assert = require('node:assert/strict');
+const path = require('node:path');
+const { servir, respostas } = require('./telas.cjs');
+const { chromium } = require('./playwright.cjs');
+
+const CAPTURAS = process.argv[2] ? path.resolve(process.argv[2]) : null;
+
+const CRUZA = {
+  versao: '0.17.0',
+  instalada: '0.16.1',
+  notas: 'SEELE 0.17.0. As notas estão em https://github.com/DATA-AND-DEV/SEELE-RELEASES/releases/tag/v0.17.0',
+  fronteira: { tipo: 'cruza', de: '1', para: '2' },
+  pede_aviso: true,
+  adiada: false,
+};
+const MESMA = {
+  versao: '0.16.2',
+  instalada: '0.16.1',
+  notas: 'SEELE 0.16.2.',
+  fronteira: { tipo: 'mesma', linha: '1' },
+  pede_aviso: false,
+  adiada: false,
+};
+const NAO_SABE = { ...CRUZA, fronteira: { tipo: 'nao_sabe' } };
+
+(async () => {
+  const server = servir();
+  await new Promise(ok => server.listen(0, '127.0.0.1', ok));
+  const browser = await chromium().launch({ headless: true });
+  let medidas = 0;
+  try {
+    const page = await browser.newPage({ viewport: { width: 1280, height: 860 } });
+    const erros = [];
+    page.on('pageerror', e => erros.push(e.message));
+    await page.addInitScript(table => {
+      window.testTable = table;
+      window.testCalls = [];
+      window.__TAURI__ = {
+        core: { invoke: async (cmd, args) => {
+          testCalls.push({ cmd, args: JSON.parse(JSON.stringify(args ?? null)) });
+          const r = testTable[cmd];
+          return typeof r === 'function' ? r(args) : (r ?? null);
+        } },
+        event: { listen: async () => () => {} },
+        window: { getCurrentWindow: () => ({ onCloseRequested() {}, isMaximized: async () => false }) },
+      };
+    }, respostas({ microfones: [], saidas: [], snapshot: null }));
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+    await page.evaluate(() => {
+      window.chamadas = cmd => testCalls.filter(c => c.cmd === cmd);
+      abrirServer('tela-boot');
+      abrirSecao('secao-atualizacao');
+    });
+
+    const visivel = sel => page.locator(sel).isVisible();
+    const oferecer = async oferta => {
+      // Um `instalar_atualizacao` que deu certo não volta no produto: o app
+      // fecha e reabre. Aqui ele volta, e os botões ficam travados como ficariam
+      // até a janela sumir; destravá-los é a «reabertura» desta bancada.
+      await page.evaluate(o => {
+        testCalls.length = 0;
+        testTable.procurar_atualizacao = o;
+        testTable.instalar_atualizacao = null;
+        $('atualizacao-procurar').disabled = false;
+        $('atualizacao-instalar').disabled = false;
+      }, oferta);
+      await page.click('#atualizacao-procurar');
+      await page.waitForFunction(() => !$('atualizacao-achado').hidden, null, { timeout: 5000 });
+    };
+    const capturar = async nome => {
+      if (!CAPTURAS) return;
+      await page.screenshot({ path: path.join(CAPTURAS, nome) });
+    };
+
+    // 1. Da 0.16 para a 0.17.
+    await oferecer(CRUZA);
+    assert.equal(await visivel('#atualizacao-travessia'), true, 'o painel não diz que a oferta fala outra versão do servidor');
+    assert.match(await page.textContent('#atualizacao-travessia'), /MUDA COM QUEM VOCÊ CONVERSA/);
+    await capturar('01-painel-com-a-travessia.png');
+    await page.click('#atualizacao-instalar');
+    assert.equal(await visivel('#travessia'), true, 'INSTALAR numa travessia não abriu a confirmação');
+    assert.deepEqual(await page.evaluate(() => chamadas('instalar_atualizacao')), [],
+      'INSTALAR numa travessia chamou instalar_atualizacao antes da confirmação');
+    const camada = await page.evaluate(() => ({
+      role: $('travessia').getAttribute('role'),
+      modal: $('travessia').getAttribute('aria-modal'),
+      titulo: $('travessia-titulo').textContent,
+      topo: $('travessia-topo').textContent,
+      itens: [...document.querySelectorAll('#travessia-consequencias li')].map(li => li.textContent),
+      foco: document.activeElement?.id,
+      botoes: [...document.querySelectorAll('#travessia button')].map(b => b.textContent.trim()),
+    }));
+    assert.equal(camada.role, 'alertdialog');
+    assert.equal(camada.modal, 'true');
+    assert.equal(camada.foco, 'travessia-cancelar', 'o foco não começa na saída que não muda nada');
+    assert.deepEqual(camada.botoes, ['CANCELAR', 'ADIAR', 'ATUALIZAR MESMO ASSIM']);
+    assert.match(camada.topo, /0\.17\.0 fala o Servidor 2\.0/);
+    assert.match(camada.topo, /0\.16\.1 fala o Servidor 1\.0/);
+    assert.ok(camada.itens.some(i => /WebRTC/.test(i) && /não conversa com a 0\.16/.test(i)), `sem a frase do WebRTC: ${camada.itens}`);
+    assert.ok(camada.itens.some(i => /não entra mais nos servidores/.test(i)), 'sem a consequência de quem atualiza');
+    assert.ok(camada.itens.some(i => /launcher/.test(i)), 'sem dizer que a versão de agora continua pelo launcher');
+    assert.ok(![camada.titulo, camada.topo, ...camada.itens].some(t => /\blinha\b/i.test(t)), 'a palavra «linha», que o ADR 0033 tirou da tela');
+    // Tab circula entre as três saídas e não sai da camada.
+    await page.keyboard.press('Tab');
+    await page.keyboard.press('Tab');
+    await page.keyboard.press('Tab');
+    assert.equal(await page.evaluate(() => document.activeElement?.id), 'travessia-cancelar', 'o Tab saiu da camada');
+    await capturar('02-confirmacao-0.16-para-0.17.png');
+    medidas++;
+
+    // 2. Cancelar.
+    await page.click('#travessia-cancelar');
+    assert.equal(await visivel('#travessia'), false);
