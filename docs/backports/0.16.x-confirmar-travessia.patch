+/* ---------- a travessia de versão do servidor (backport 0.16.x) ----------
+
+   A frase que diz, já no painel, que a oferta fala outra versão do servidor, e
+   a camada `#travessia` que pede a confirmação. A camada reusa a caixa do
+   diálogo de nomear (`camada-nomear.css`), que já fica acima desta tela (26
+   contra 24); aqui só o que é dela. Laranja, pelo mesmo motivo do aviso de
+   cima: é o preço de uma ação que ainda não aconteceu, e não uma falha. */
+
+.server-atualizacao-travessia {
+  margin: 0;
+  max-width: 72ch;
+  padding: 12px 16px;
+  font-size: var(--seele-t-dado);
+  line-height: 1.6;
+  color: var(--seele-osso);
+  border: 1px solid var(--seele-laranja-nerv);
+  background: var(--seele-laranja-fraco);
+}
+
+.travessia-caixa {
+  max-width: 560px;
+  border-color: var(--seele-laranja-nerv);
+}
+
+/* O título desta camada quebra em duas linhas a 560px, e o de nomear herda a
+   altura de linha de uma linha só; sem isto as duas se sobrepõem. */
+.travessia-caixa .nomear-titulo {
+  font-size: 20px;
+  line-height: 1.2;
+}
+
+.travessia-texto {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.travessia-topo {
+  margin: 0;
+  font-size: var(--seele-t-dado);
+  line-height: 1.6;
+  color: var(--seele-osso);
+}
+
+.travessia-consequencias {
+  margin: 0;
+  padding-left: 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  font-size: var(--seele-t-dado);
+  line-height: 1.6;
+  color: var(--seele-osso);
+}
+
+/* Três saídas numa caixa de 560px: quebram de linha em vez de espremer. */
