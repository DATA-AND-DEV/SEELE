+                    escolha("seele/estilo", atualizar(&hash_do_estilo_4)),
+                ],
+                false,
+                FalhaAoResolverModAntigo::NaoEDeApiAntiga,
+            ),
+            (
+                vec![escolha("seele/estilo", atualizar(&hash_de_outro))],
+                false,
+                FalhaAoResolverModAntigo::PacoteNaoServe("conteudo-de-outro-mod".to_owned()),
+            ),
+            (
+                vec![escolha("seele/estilo", atualizar(&hash_do_estilo_4))],
+                true,
+                FalhaAoResolverModAntigo::ServidorNoAr,
+            ),
+        ];
+        for (escolhas, no_ar, esperada) in recusados {
+            assert_eq!(
+                aplicar_saidas_dos_mods_antigos(&config, None, &escolhas, no_ar),
+                Err(esperada.clone()),
+                "{escolhas:?}"
+            );
+            assert_eq!(
+                bytes_do_banco(&dir),
+                antes,
+                "a recusa {esperada:?} mexeu no banco"
+            );
+            assert!(sem_copia(&dir), "a recusa {esperada:?} fez cópia");
+        }
+    }
+
+    /// **Sem a cópia verificada, nada é convertido.** Com a pasta das cópias
+    /// impossível de criar, o botão final recusa com `CopiaNaoFeita`, e o
+    /// banco fica byte a byte como estava, no esquema 13.
+    #[test]
+    fn sem_a_copia_verificada_nada_e_convertido() {
+        let (dir, config) = pasta_da_0_15_1();
+        let antes = bytes_do_banco(&dir);
+        // Um arquivo no lugar da pasta: `create_dir_all` falha.
+        std::fs::write(
+            dir.path().join(crate::copia_do_banco::PASTA_DAS_COPIAS),
+            b"nao e pasta",
+        )
+        .unwrap();
+        let falha = aplicar_saidas_dos_mods_antigos(
+            &config,
+            None,
+            &[escolha("seele/estilo", SaidaDoModAntigo::Desligar)],
+            false,
+        );
+        assert!(
+            matches!(falha, Err(FalhaAoResolverModAntigo::CopiaNaoFeita(_))),
+            "{falha:?}"
+        );
+        assert_eq!(
+            bytes_do_banco(&dir),
+            antes,
+            "a cópia falhou e o banco mudou"
+        );
+        assert_eq!(esquema(&banco(&dir)), 13);
+    }
+
+    /// **O botão final: a cópia verificada primeiro, depois a conversão e as
+    /// escolhas.** A cópia é o estado de antes, inteiro (o mesmo conteúdo
+    /// lógico do banco da 0.15.1, no esquema 13, com o 3.1.0 ligado); o banco
+    /// passa ao esquema deste build com o 4.0.0, e o quintal fica.
+    #[test]
+    fn o_botao_final_copia_o_estado_de_antes_e_so_entao_converte() {
+        let (dir, config) = pasta_da_0_15_1();
+        let antes = conteudo(&banco(&dir));
+        let quintal = quintal_do_estilo(&banco(&dir));
+        let hash = estilo_4_no_cache(&config);
+
+        let copia = aplicar_saidas_dos_mods_antigos(
+            &config,
+            None,
+            &[escolha(
+                "seele/estilo",
+                SaidaDoModAntigo::Atualizar { hash: hash.clone() },
+            )],
+            false,
+        )
+        .expect("o botão final não aplicou");
+
+        assert!(copia.starts_with(
+            dir.path()
+                .join(crate::copia_do_banco::PASTA_DAS_COPIAS)
+                .join("padrao")
+        ));
+        assert_eq!(esquema(&copia), 13, "a cópia não é do esquema de antes");
+        assert_eq!(
+            conteudo(&copia),
+            antes,
+            "a cópia não tem o conteúdo de antes"
+        );
+        assert_eq!(linha_do_estilo(&copia).0, "3.1.0");
+
+        assert_eq!(esquema(&banco(&dir)), esquema_deste_build());
+        assert_eq!(linha_do_estilo(&banco(&dir)), ("4.0.0".to_owned(), hash, 1));
+        assert_eq!(quintal_do_estilo(&banco(&dir)), quintal, "o quintal mudou");
+    }
 }
 
