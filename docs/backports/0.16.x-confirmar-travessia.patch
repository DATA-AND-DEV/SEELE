+#[test]
+fn a_falha_da_travessia_nao_confirmada_tem_frase() {
+    let rust = read("src/main.rs");
+    let falhas = variants_of(&rust, "FalhaAoAtualizar");
+    assert!(
+        falhas.iter().any(|f| f == "TravessiaNaoConfirmada"),
+        "o leitor não achou `TravessiaNaoConfirmada` em `FalhaAoAtualizar`: {falhas:?}"
+    );
+    let frases = without_comments(&read("ui/frases.js"));
+    assert!(
+        frases.contains("TravessiaNaoConfirmada:"),
+        "`TravessiaNaoConfirmada` chega à tela como o nome cru do enum"
+    );
+}
+
+/// **As saídas dos MODs de API antiga só escolhem; quem converte é o botão
+/// final** (backport 0.16.x). Na 0.16.0 cada clique em ATUALIZAR ou DESLIGAR
+/// chamava o Rust, que migrava o banco na hora. Aqui: o único `invoke` que
+/// grava é o do botão final; escolher, DESFAZER e CANCELAR não chamam o Rust.
+/// O comportamento é medido pela bancada `saidas-de-quem-hospeda.cjs`.
+#[test]
+fn as_saidas_dos_mods_antigos_so_escolhem_e_quem_converte_e_o_botao_final() {
+    let boot = read("ui/tela-boot.js");
+    let corpo = js_function(&boot, "async function desenharSaidasDeQuemHospeda(");
+    let gravar = "invoke(\"aplicar_saidas_dos_mods_antigos\"";
+    assert_eq!(
+        without_comments(&scripts()).matches(gravar).count(),
+        1,
+        "o comando que converte o banco é chamado de mais de um lugar, ou de nenhum"
+    );
+    assert!(
+        !without_comments(&scripts()).contains("invoke(\"resolver_mod_de_api_antiga\""),
+        "o comando da 0.16.0, que convertia o banco a cada clique, voltou à tela"
+    );
+
+    let escolher = corpo.find("const escolher =").unwrap_or(usize::MAX);
+    let botao_final = corpo
+        .find("confirmar.addEventListener(\"click\"")
+        .unwrap_or(0);
+    let cancelar = corpo
+        .find("cancelar.addEventListener(\"click\"")
+        .unwrap_or(0);
+    let filhos = corpo.find("const filhos").unwrap_or(0);
+    let grava = corpo.find(gravar).unwrap_or(usize::MAX);
+    assert!(
+        escolher < botao_final && botao_final < grava && grava < cancelar && cancelar < filhos,
+        "o `invoke` que converte não está só dentro do botão final:\n{corpo}"
+    );
+    assert!(
+        !corpo[escolher..botao_final].contains("invoke("),
+        "escolher uma saída chama o Rust, e o banco muda antes da confirmação:\n{}",
+        &corpo[escolher..botao_final]
+    );
+    assert!(
+        !corpo[cancelar..filhos].contains("invoke("),
+        "CANCELAR chama o Rust:\n{}",
+        &corpo[cancelar..filhos]
+    );
+    let desfazer = corpo
+        .find("desfazer.addEventListener(\"click\"")
+        .unwrap_or(0);
+    let depois = &corpo[desfazer..];
+    let fim = depois.find("});").unwrap_or(depois.len());
+    assert!(
+        desfazer > 0 && !depois[..fim].contains("invoke("),
+        "DESFAZER chama o Rust, ou sumiu"
+    );
+}
