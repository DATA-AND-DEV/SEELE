+#[test]
+fn a_confirmacao_da_travessia_e_um_alertdialog_com_as_tres_saidas() {
+    let pagina = read("ui/index.html");
+    let camada = tag_with_id(&pagina, "travessia");
+    for atributo in [
+        "role=\"alertdialog\"",
+        "aria-modal=\"true\"",
+        "aria-labelledby=\"travessia-titulo\"",
+        "aria-describedby=\"travessia-texto\"",
+        "hidden",
+    ] {
+        assert!(
+            camada.contains(atributo),
+            "a camada da travessia perdeu `{atributo}`: <{camada}>"
+        );
+    }
+    for saida in [
+        "travessia-cancelar",
+        "travessia-adiar",
+        "travessia-prosseguir",
+    ] {
+        assert!(
+            without_comments(&pagina).contains(&format!("<button type=\"button\" id=\"{saida}\"")),
+            "a saída `{saida}` não é um botão"
+        );
+    }
+
+    // O foco começa em CANCELAR: um Enter dado sem ler não pode ser a travessia.
+    let abrir = js_function(&read("ui/tela-server.js"), "function abrirTravessia(");
+    assert!(
+        abrir.contains("$(\"travessia-cancelar\").focus()"),
+        "a confirmação abre com o foco fora de CANCELAR:\n{abrir}"
+    );
+    assert!(
+        read("ui/tela-server.js").contains("fecharAoClicarFora(\"travessia\""),
+        "a camada da travessia não fecha (cancelando) apertando fora dela"
+    );
+}
