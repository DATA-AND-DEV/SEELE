+
+// ------------------------------------- a travessia de versão do servidor
+//
+// Backport 0.16.x do E4 da 0.17: a confirmação antes de atualizar para outra
+// versão do servidor. O comportamento na tela é medido pela bancada
+// `bancada/travessia-de-versao.cjs` (Playwright); estes guardas são os que
+// rodam em todo `cargo test`, sem navegador.
+
+#[test]
+fn instalar_uma_travessia_e_recusado_antes_de_baixar_sem_a_confirmacao_desta_versao() {
+    let rust = without_comments(&read("src/main.rs"));
+    let instalar = body_of(&rust, "async fn instalar_atualizacao(");
+    assert!(
+        instalar.contains("confirmada: Option<String>"),
+        "`instalar_atualizacao` não recebe mais a versão confirmada:\n{instalar}"
+    );
+    let decide = instalar.find("pode_instalar(").unwrap_or(usize::MAX);
+    let baixa = instalar.find(".download(").unwrap_or(0);
+    assert!(
+        decide < baixa,
+        "a travessia é conferida depois de baixar, ou não é conferida — a confirmação \
+         tem de vir antes do primeiro byte:\n{instalar}"
+    );
+    assert!(
+        instalar[decide..baixa].contains("TravessiaNaoConfirmada"),
+        "a recusa da travessia não confirmada sumiu de `instalar_atualizacao`"
+    );
+
+    // E os dois comandos novos chegam à tela: sem estar no `generate_handler!`,
+    // cancelar e adiar seriam um `invoke` que nunca responde.
+    let registro = rust
+        .split("generate_handler![")
+        .nth(1)
+        .and_then(|resto| resto.split(']').next())
+        .unwrap_or_default();
+    assert!(
+        registro.contains("escolher_atualizacao"),
+        "`escolher_atualizacao` não está registrado: cancelar e adiar não chegam ao Rust"
+    );
+}
+
+#[test]
+fn o_clique_em_instalar_passa_pela_confirmacao_quando_a_oferta_pede() {
+    let servidor = read("ui/tela-server.js");
+    assert!(
+        without_comments(&servidor)
+            .contains("$(\"atualizacao-instalar\").addEventListener(\"click\", aoApertarInstalar)"),
+        "o botão de instalar foi ligado direto a `instalarAtualizacao`, e uma travessia \
+         instala sem ver a confirmação"
+    );
+
+    let apertar = js_function(&servidor, "function aoApertarInstalar(");
+    let pede = apertar.find("pede_aviso").unwrap_or(usize::MAX);
+    let abre = apertar.find("abrirTravessia(").unwrap_or(usize::MAX);
+    let instala = apertar.find("instalarAtualizacao(").unwrap_or(0);
+    assert!(
+        pede < abre && abre < instala,
+        "`aoApertarInstalar` instala antes de perguntar se a oferta pede confirmação:\n{apertar}"
+    );
+    assert!(
+        apertar[abre..instala].contains("return"),
+        "depois de abrir a confirmação, o clique segue e instala do mesmo jeito:\n{apertar}"
+    );
+
+    // Só prosseguir instala, e com a versão que a camada mostrou; cancelar e
+    // adiar vão a `escolher_atualizacao`.
+    let escolher = js_function(&servidor, "async function escolherNaTravessia(");
+    assert!(
+        escolher.contains("instalarAtualizacao(versao)"),
+        "prosseguir não manda a versão mostrada na confirmação:\n{escolher}"
+    );
+    assert!(
+        escolher.contains("invoke(\"escolher_atualizacao\""),
+        "cancelar e adiar não avisam o Rust, e a oferta continua escolhida:\n{escolher}"
+    );
+}
