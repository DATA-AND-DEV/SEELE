+            pode_instalar(&f, "0.16.2", Escolha::Prosseguir, None),
+            Ok(())
+        );
+    }
+
+    /// Sem a entrada da versão nova, ou com um `server` ilegível, não se sabe —
+    /// e não saber avisa.
+    #[test]
+    fn sem_a_linha_no_manifesto_avisa() {
+        let m = manifesto(&[("0.16.1", 9, "1.0")]);
+        assert_eq!(
+            fronteira_da_oferta(Some(&linha("1")), &m, "0.17.0"),
