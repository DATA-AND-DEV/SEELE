diff --git a/apps/seele-app/src/perfis_api5_testes.rs b/apps/seele-app/src/perfis_api5_testes.rs
new file mode 100644
index 00000000..49394b09
--- /dev/null
+++ b/apps/seele-app/src/perfis_api5_testes.rs
@@ -0,0 +1,471 @@
+//! **O Perfis 3.3.1 (API 5) atravessa para o 4.0.0 (API 6) pelas saídas
+//! estagiadas do backport 0.16.x** (`revisao-astra-travessia-api5-6.md`,
+//! «validação nova mínima»).
+//!
+//! O caso relatado: quem hospedou na 0.15 com o `seele/perfis` 3.3.1 ligado
+//! abre a 0.16.x. A API 5 não roda no Servidor 1.0 (a API mínima é a 6) e não
+//! passa a rodar: o HOSPEDAR recusa, e a saída é ATUALIZAR para o 4.0.0. Pelas
+//! funções de verdade (`mods_de_api_antiga`, `aplicar_saidas_dos_mods_antigos`,
+//! o servidor de pé), prova-se:
+//!
+//! 1. o HOSPEDAR recusaria com `("seele/perfis", Some(5))`;
+//! 2. antes da confirmação o banco fica byte a byte como estava: a leitura da
+//!    tela e os botões finais recusados (sem escolha, servidor no ar) não o
+//!    tocam e não fazem cópia. Escolher, DESFAZER e CANCELAR moram só na tela
+//!    e não chamam o Rust (`tests/frontend.rs` e a bancada das saídas);
+//! 3. o botão final faz a cópia do estado de antes (esquema 13, o 3.3.1, o
+//!    `mod_data`) e só então converte e liga o 4.0.0;
+//! 4. o `mod_data` do Perfis chega igual, byte a byte, e a metade de servidor
+//!    do 4.0.0 o lê pelo caminho de pedido do servidor de pé.
+//!
+//! # Duas medidas, com pacotes diferentes, ditas
+//!
+//! - [`com_os_substitutos_da_fixture`] roda sempre: a pasta
+//!   `testes/pasta-da-0.15.1-perfis/` (banco e `mod_data` gravados **pelo
+//!   código da v0.15.1**), com o 3.3.1 e o 4.0.0 **substitutos** dela (o id, a
+//!   versão e a API dos oficiais, não os bytes nem o hash).
+//! - [`com_os_pacotes_oficiais`] usa os pacotes **oficiais** 3.3.1 e 4.0.0,
+//!   cujos hashes são conferidos contra o catálogo. Eles não estão neste
+//!   repositório (meio megabyte cada), então o teste é `#[ignore]` e lê a pasta
+//!   deles de `SEELE_PERFIS_OFICIAIS` (com `3.3.1/` e `4.0.0/` dentro):
+//!
+//!   ```sh
+//!   cargo test --manifest-path apps/seele-app/Cargo.toml \
+//!     --config 'env.SEELE_PERFIS_OFICIAIS="<pasta>"' -- --ignored com_os_pacotes_oficiais
+//!   ```
+//!
+//!   O banco é o da fixture (esquema 13, a conta de quem hospeda), com a linha
+//!   do Perfis apontando o hash do 3.3.1 oficial e o `mod_data` **na forma que
+//!   o servidor do 3.3.1 oficial grava** (`dados.profiles`, o perfil de cada
+//!   pessoa pelo `validate` dele). Esse `mod_data` foi escrito aqui, e não pelo
+//!   3.3.1 rodando numa 0.15.1.
+#![allow(
+    clippy::unwrap_used,
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    reason = "num teste, o pânico é o relatório; e indexar um serde_json::Value devolve Null"
+)]
+
+use std::path::{Path, PathBuf};
+
+use crate::mods::{
+    aplicar_saidas_dos_mods_antigos, mods_de_api_antiga, EscolhaDoModAntigo,
+    FalhaAoResolverModAntigo, ModDeApiAntiga, SaidaDoModAntigo,
+};
+
+/// A pasta de quem hospedou na 0.15.1 com o Perfis 3.3.1 (API 5).
+const PASTA: &str = concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/testes/pasta-da-0.15.1-perfis/pasta"
+);
+
+/// O hash do Perfis 3.3.1 substituto, que a 0.15.1 gravou em `mods`.
+const HASH_DO_SUBSTITUTO: &str = "d3f49d8addc6ee4ef438620af18e3981dc1ef5899b8b5b157564e8ead4902b2d";
+
+/// Os hashes dos pacotes oficiais, como o catálogo os publica
+/// (`catalogo-dos-pacotes.json`, ao lado deles).
+const HASH_OFICIAL_3_3_1: &str = "ec9fb794da41c8bf6d331f934024dcb9385ebb8db3434a2886b142683e4e8b96";
+const HASH_OFICIAL_4_0_0: &str = "6c5ecf4ea2d1b9ae2c201de8fee24c1c4c3ee1f3ff39d9e0f10710f796f7a368";
+
+const PERFIS: &str = "seele/perfis";
+
+fn copiar(de: &Path, para: &Path) {
+    std::fs::create_dir_all(para).unwrap();
+    for entrada in std::fs::read_dir(de).unwrap() {
+        let entrada = entrada.unwrap();
+        let destino = para.join(entrada.file_name());
+        if entrada.path().is_dir() {
+            copiar(&entrada.path(), &destino);
+        } else {
+            std::fs::copy(entrada.path(), destino).unwrap();
+        }
+    }
+}
+
+/// Os arquivos de uma pasta, com o caminho relativo em `/`, para o hash.
+fn arquivos(raiz: &Path) -> Vec<(String, Vec<u8>)> {
+    fn andar(raiz: &Path, pasta: &Path, achados: &mut Vec<(String, Vec<u8>)>) {
+        for entrada in std::fs::read_dir(pasta).unwrap() {
+            let caminho = entrada.unwrap().path();
+            if caminho.is_dir() {
+                andar(raiz, &caminho, achados);
+            } else {
+                let relativo = caminho
+                    .strip_prefix(raiz)
+                    .unwrap()
+                    .components()
+                    .map(|parte| parte.as_os_str().to_string_lossy().into_owned())
+                    .collect::<Vec<_>>()
+                    .join("/");
+                achados.push((relativo, std::fs::read(&caminho).unwrap()));
+            }
+        }
+    }
+    let mut achados = Vec::new();
+    andar(raiz, raiz, &mut achados);
+    achados
+}
+
+fn ler(banco: &Path) -> rusqlite::Connection {
+    rusqlite::Connection::open_with_flags(banco, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY)
+        .unwrap()
+}
+
+fn esquema(banco: &Path) -> i64 {
+    ler(banco)
+        .query_row(
+            "SELECT COALESCE(MAX(version), 0) FROM schema_version",
+            [],
+            |l| l.get(0),
+        )
+        .unwrap()
+}
+
+/// A linha do Perfis em `mods`: versão, hash e ligado.
+fn linha_do_perfis(banco: &Path) -> (String, String, i64) {
+    ler(banco)
+        .query_row(
+            "SELECT version, hash, enabled FROM mods WHERE id = ?1",
+            [PERFIS],
+            |l| Ok((l.get(0)?, l.get(1)?, l.get(2)?)),
+        )
+        .unwrap()
+}
+
+/// O `mod_data` do Perfis, linha por linha, como o disco o tem.
+fn quintal_do_perfis(banco: &Path) -> Vec<(String, Vec<u8>)> {
+    let conexao = ler(banco);
+    let mut consulta = conexao
+        .prepare("SELECT key, CAST(value AS BLOB) FROM mod_data WHERE mod_id = ?1 ORDER BY key")
+        .unwrap();
+    consulta
+        .query_map([PERFIS], |l| Ok((l.get(0)?, l.get(1)?)))
+        .unwrap()
+        .map(Result::unwrap)
+        .collect()
+}
+
+/// O SHA-256 do banco e dos arquivos ao lado dele: o que «nada mudou» quer dizer.
+fn bytes_do_banco(banco: &Path) -> Vec<(String, Option<String>)> {
+    use sha2::Digest as _;
+    ["", "-wal", "-shm", "-journal"]
+        .into_iter()
+        .map(|sufixo| {
+            let caminho = format!("{}{sufixo}", banco.display());
+            let resumo = std::fs::read(&caminho).ok().map(|bytes| {
+                sha2::Sha256::digest(&bytes)
+                    .iter()
+                    .map(|byte| format!("{byte:02x}"))
+                    .collect::<String>()
+            });
+            (sufixo.to_owned(), resumo)
+        })
+        .collect()
+}
+
+fn copias_no_disco(config: &Path) -> Vec<PathBuf> {
+    std::fs::read_dir(
+        config
+            .join(crate::copia_do_banco::PASTA_DAS_COPIAS)
+            .join("padrao"),
+    )
+    .into_iter()
+    .flatten()
+    .flatten()
+    .map(|entrada| entrada.path())
+    .collect()
+}
+
+/// A pasta da 0.15.1 com o Perfis, sem migrar: o banco de sempre e o pacote
+/// substituto no cache por hash.
+fn pasta_da_0_15_1() -> (tempfile::TempDir, String) {
+    let dir = tempfile::tempdir().unwrap();
+    rusqlite::Connection::open(dir.path().join("seele.db"))
+        .unwrap()
+        .execute_batch(&std::fs::read_to_string(format!("{PASTA}/seele.sql")).unwrap())
+        .unwrap();
+    copiar(
+        &Path::new(PASTA).join("mod-packages"),
+        &dir.path().join("mod-packages"),
+    );
+    let config = dir.path().to_string_lossy().into_owned();
+    (dir, config)
+}
+
+/// O Perfis 4.0.0 substituto, na API 6, instalado no cache por hash. Lê o
+/// perfil que o 3.3.1 substituto gravou (`perfil:<pessoa>`).
+fn substituto_4_no_cache(config: &str) -> String {
+    let origem = tempfile::tempdir().unwrap();
+    std::fs::create_dir_all(origem.path().join("servidor")).unwrap();
+    std::fs::write(
+        origem.path().join("mod.json"),
+        serde_json::json!({
+            "schema": 1,
+            "id": PERFIS,
+            "version": "4.0.0",
+            "api": 6,
+            "repo": "https://github.com/DATA-AND-DEV/SEELE-MOD-PERFIS",
+            "reach": ["perfil de cada pessoa"],
+            "server": "servidor/main.js",
+        })
+        .to_string(),
+    )
+    .unwrap();
+    std::fs::write(
+        origem.path().join("servidor/main.js"),
+        "globalThis.aoPedir = (contextoJSON) => { \
+           const contexto = JSON.parse(contextoJSON); \
+           const guardado = dados['perfil:' + contexto.person]; \
+           return JSON.stringify({ ok: true, versao: '4.0.0', perfil: guardado ?? null }); \
+         };",
+    )
+    .unwrap();
+    crate::mods::instalar_de(Path::new(config), origem.path())
+        .unwrap()
+        .hash
+}
+
+/// O que se mede, e com quais pacotes.
+struct Travessia {
+    dir: tempfile::TempDir,
+    config: String,
+    /// O hash do 3.3.1 ligado no banco.
+    hash_3: String,
+    /// O hash do 4.0.0 no cache.
+    hash_4: String,
+}
+
+/// **A travessia, do HOSPEDAR recusado ao botão final.** Devolve a resposta do
+/// 4.0.0 de pé a um `view` de quem hospeda, para cada medida conferir o que o
+/// pacote dela lê.
+fn atravessar(t: &Travessia) -> serde_json::Value {
+    let config = t.config.as_str();
+    let banco = crate::servidores::banco_de_hospedar(config, None);
+    let raizes = crate::servidores::raizes_dos_mods(config, None);
+    let bytes_antes = bytes_do_banco(&banco);
+    let linha_antes = linha_do_perfis(&banco);
+    let quintal_antes = quintal_do_perfis(&banco);
+    assert_eq!(esquema(&banco), 13, "a pasta não é a da 0.15.1");
+    assert_eq!(
+        linha_antes,
+        ("3.3.1".to_owned(), t.hash_3.clone(), 1),
+        "o Perfis 3.3.1 não está ligado na pasta"
+    );
+    assert!(
+        !quintal_antes.is_empty(),
+        "a pasta não tem o mod_data do Perfis"
+    );
+
+    // 1. O HOSPEDAR recusaria pela API 5 — a mesma conferência dele.
+    assert_eq!(
+        mods_de_api_antiga(&banco, &raizes),
+        vec![ModDeApiAntiga {
+            id: PERFIS.to_owned(),
+            api: Some(5)
+        }],
+        "hospedar não recusaria o Perfis da API 5"
+    );
+
+    // 2. Antes da confirmação: os botões finais recusados não tocam em nada.
+    let atualizar = EscolhaDoModAntigo {
+        id: PERFIS.to_owned(),
+        saida: SaidaDoModAntigo::Atualizar {
+            hash: t.hash_4.clone(),
+        },
+    };
+    assert_eq!(
+        aplicar_saidas_dos_mods_antigos(config, None, &[], false),
+        Err(FalhaAoResolverModAntigo::FaltaEscolher(vec![
+            PERFIS.to_owned()
+        ]))
+    );
+    assert_eq!(
+        aplicar_saidas_dos_mods_antigos(config, None, std::slice::from_ref(&atualizar), true),
+        Err(FalhaAoResolverModAntigo::ServidorNoAr)
+    );
+    assert_eq!(
+        bytes_do_banco(&banco),
+        bytes_antes,
+        "antes da confirmação, o banco mudou"
+    );
+    assert_eq!(esquema(&banco), 13, "antes da confirmação, o banco migrou");
+    assert!(
+        copias_no_disco(t.dir.path()).is_empty(),
+        "uma cópia apareceu antes da confirmação"
+    );
+
+    // 3. O botão final: a cópia do estado de antes, depois a conversão.
+    let copia = aplicar_saidas_dos_mods_antigos(config, None, &[atualizar], false)
+        .expect("o botão final com o 4.0.0 escolhido não aplicou");
+    assert_eq!(copias_no_disco(t.dir.path()), vec![copia.clone()]);
+    assert_eq!(esquema(&copia), 13, "a cópia não é do estado de antes");
+    assert_eq!(
+        linha_do_perfis(&copia),
+        linha_antes,
+        "a cópia não tem o 3.3.1"
+    );
+    assert_eq!(
+        quintal_do_perfis(&copia),
+        quintal_antes,
+        "a cópia não tem o mod_data de antes"
+    );
+    assert!(esquema(&banco) > 13, "o botão final não converteu o banco");
+    assert_eq!(
+        linha_do_perfis(&banco),
+        ("4.0.0".to_owned(), t.hash_4.clone(), 1),
+        "o botão final não ligou o 4.0.0"
+    );
+    assert_eq!(
+        quintal_do_perfis(&banco),
+        quintal_antes,
+        "a travessia mexeu no mod_data do Perfis"
+    );
+    assert!(
+        mods_de_api_antiga(&banco, &raizes).is_empty(),
+        "depois do botão final, hospedar ainda recusaria"
+    );
+
+    // 4. O servidor de pé, com o 4.0.0, lê o mod_data.
+    let rt = tokio::runtime::Builder::new_multi_thread()
+        .enable_all()
+        .build()
+        .unwrap();
+    rt.block_on(async {
+        let servidor = seele_server::Daemon::bind(seele_server::ServerConfig {
+            name: "Casa".to_owned(),
+            mods_dir: Some(raizes),
+            listen: std::net::SocketAddr::from((std::net::Ipv4Addr::LOCALHOST, 0)),
+            database: seele_server::persistence::Location::File(banco.clone()),
+            ..seele_server::ServerConfig::default()
+        })
+        .await
+        .expect("o servidor não subiu depois do botão final");
+        let server = std::sync::Arc::clone(servidor.server());
+        let dono = {
+            let banco = server.persistence.lock().await;
+            seele_server::permissions::Permissions::new(&banco)
+                .register_or_find(&[0x5e; 32], "dono")
+                .unwrap()
+        };
+        let resposta = seele_server::mods::pedidos::executar(
+            &server,
+            dono.id,
+            0_u32.into(),
+            PERFIS,
+            r#"{"op":"view"}"#,
+        )
+        .await;
+        servidor.shutdown();
+        serde_json::from_str(&resposta)
+            .unwrap_or_else(|_| panic!("a resposta do 4.0.0 não é JSON: {resposta}"))
+    })
+}
+
+/// **Com os substitutos da fixture**: o `mod_data` foi gravado pelo 3.3.1
+/// substituto rodando no código da v0.15.1.
+#[test]
+fn com_os_substitutos_da_fixture() {
+    let (dir, config) = pasta_da_0_15_1();
+    let hash_4 = substituto_4_no_cache(&config);
+    let perfil = quintal_do_perfis(&dir.path().join("seele.db"));
+    let t = Travessia {
+        dir,
+        config,
+        hash_3: HASH_DO_SUBSTITUTO.to_owned(),
+        hash_4,
+    };
+    let lido = atravessar(&t);
+    assert_eq!(
+        lido["versao"], "4.0.0",
+        "o pedido não chegou ao 4.0.0: {lido}"
+    );
+    let (_, gravado) = perfil.first().unwrap();
+    assert_eq!(
+        lido["perfil"].as_str().map(str::as_bytes),
+        Some(gravado.as_slice()),
+        "o 4.0.0 não leu o perfil que o 3.3.1 gravou na 0.15.1: {lido}"
+    );
+}
+
+/// **Com os pacotes oficiais** 3.3.1 e 4.0.0, conferidos contra o catálogo.
+/// Ver o cabeçalho do módulo para rodar.
+#[test]
+#[ignore = "precisa dos pacotes oficiais em SEELE_PERFIS_OFICIAIS"]
+fn com_os_pacotes_oficiais() {
+    let Ok(oficiais) = std::env::var("SEELE_PERFIS_OFICIAIS") else {
+        panic!("SEELE_PERFIS_OFICIAIS não foi dada: sem os pacotes oficiais, nada a medir");
+    };
+    let oficiais = Path::new(&oficiais);
+
+    // Os pacotes são os do catálogo, byte a byte.
+    let mut do_3 = arquivos(&oficiais.join("3.3.1"));
+    assert_eq!(
+        seele_ffi::mods::hash_do_conjunto(&mut do_3),
+        HASH_OFICIAL_3_3_1,
+        "a pasta do 3.3.1 não é o pacote oficial"
+    );
+
+    // A pasta da 0.15.1: o 3.3.1 oficial no cache por hash, como a 0.15.1 o
+    // deixava, e a linha do Perfis apontando para ele.
+    let (dir, config) = pasta_da_0_15_1();
+    copiar(
+        &oficiais.join("3.3.1"),
+        &dir.path().join("mod-packages").join(HASH_OFICIAL_3_3_1),
+    );
+    let hash_4 = crate::mods::instalar_de(dir.path(), &oficiais.join("4.0.0"))
+        .expect("o 4.0.0 oficial não instalou")
+        .hash;
+    assert_eq!(
+        hash_4, HASH_OFICIAL_4_0_0,
+        "o 4.0.0 instalado não é o pacote oficial"
+    );
+
+    // O mod_data na forma que o servidor do 3.3.1 oficial grava: `profiles`,
+    // o perfil de cada pessoa pelo `validate` dele (pessoa 1, quem hospeda).
+    let perfil = serde_json::json!({
+        "revision": 1,
+        "displayName": "Dona da casa",
+        "pronouns": "ela",
+        "bio": "hospedo desde a 0.15",
+        "status": "por aqui",
+        "accent": "#f2521f",
+        "effect": "aurora",
+        "avatar": null,
+        "banner": null,
+    });
+    {
+        let banco = rusqlite::Connection::open(dir.path().join("seele.db")).unwrap();
+        banco
+            .execute(
+                "UPDATE mods SET hash = ?1, repo = 'https://github.com/DATA-AND-DEV/PERFIS', \
+                 reach = '[\"regiao\",\"perfis no servidor\",\"arquivos de perfis\"]' WHERE id = ?2",
+                [HASH_OFICIAL_3_3_1, PERFIS],
+            )
+            .unwrap();
+        banco
+            .execute("DELETE FROM mod_data WHERE mod_id = ?1", [PERFIS])
+            .unwrap();
+        banco
+            .execute(
+                "INSERT INTO mod_data VALUES (?1, 'profiles', ?2)",
+                rusqlite::params![
+                    PERFIS,
+                    serde_json::json!({ "1": perfil }).to_string().into_bytes()
+                ],
+            )
+            .unwrap();
+    }
+
+    let t = Travessia {
+        dir,
+        config,
+        hash_3: HASH_OFICIAL_3_3_1.to_owned(),
+        hash_4,
+    };
+    let lido = atravessar(&t);
+    assert_eq!(lido["ok"], true, "o 4.0.0 oficial recusou o view: {lido}");
+    assert_eq!(
+        lido["profiles"]["1"], perfil,
+        "o 4.0.0 oficial não leu o perfil gravado na forma do 3.3.1: {lido}"
+    );
+}
