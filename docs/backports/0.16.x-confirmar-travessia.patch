+
+// ------------------------------------------- a travessia de versão do servidor
+//
+// Backport 0.16.x do E4 da 0.17. Quando a oferta fala outra versão do servidor
+// (`pede_aviso`), INSTALAR não instala: abre `#travessia`, com cancelar, adiar
+// e prosseguir. Só prosseguir manda a versão confirmada ao Rust, e só com ela
+// `instalar_atualizacao` baixa. Na mesma versão do servidor o clique é o de
+// sempre, sem camada nenhuma.
+
+/** A última oferta desenhada, com a `fronteira` que o Rust decidiu. */
+let ofertaNaTela = null;
+
+/** Para onde o teclado volta quando a confirmação fecha. */
+let focoAntesDaTravessia = null;
+
+/** O clique em INSTALAR E REABRIR: confirma antes, se a oferta pede. */
+function aoApertarInstalar() {
+  if (ofertaNaTela?.pede_aviso) {
+    abrirTravessia(ofertaNaTela);
+    return;
   }
+  instalarAtualizacao(null);
+}
+
+/** Abre a confirmação para `nova`, com o foco em CANCELAR. */
+function abrirTravessia(nova) {
+  focoAntesDaTravessia = document.activeElement;
+  const frases = frasesDaTravessia(nova);
+  $("travessia-titulo").textContent = frases.titulo;
+  $("travessia-topo").textContent = frases.topo;
+  $("travessia-consequencias").replaceChildren(
+    ...frases.consequencias.map((frase) => {
+      const item = document.createElement("li");
+      item.textContent = frase;
+      return item;
+    }),
+  );
+  const adiada = $("travessia-adiada");
+  adiada.hidden = frases.adiada === "";
+  adiada.textContent = frases.adiada;
+
+  const camada = $("travessia");
+  camada.dataset.versao = nova.versao;
+  camada.hidden = false;
+  // CANCELAR, e não ATUALIZAR: um Enter dado sem ler não pode ser a travessia.
+  $("travessia-cancelar").focus();
 }
 
+/** Fecha a confirmação, devolvendo o teclado a quem abriu. */
+function fecharTravessia() {
+  const camada = $("travessia");
+  camada.hidden = true;
+  delete camada.dataset.versao;
+  if (focavel(focoAntesDaTravessia)) focoAntesDaTravessia.focus();
+  focoAntesDaTravessia = null;
+}
+
+/**
+ * Uma das três saídas. Cancelar e adiar não baixam nada: o Rust tira a oferta
+ * do lugar, e adiar guarda a versão para a próxima procura dizer que foi
+ * adiada. Prosseguir instala com a versão que esta camada mostrou.
+ */
+async function escolherNaTravessia(escolha) {
+  const camada = $("travessia");
+  if (camada.hidden) return;
+  const versao = camada.dataset.versao;
+  fecharTravessia();
+
+  if (escolha === "prosseguir") {
+    await instalarAtualizacao(versao);
+    return;
+  }
+
+  try {
+    await invoke("escolher_atualizacao", { escolha });
+  } catch (falha) {
+    // `NadaEscolhido`: não havia oferta guardada, e então não há o que baixar
+    // de qualquer jeito. O resultado para quem lê é o mesmo.
+    console.warn("escolher_atualizacao:", falha);
+  }
+  ofertaNaTela = null;
+  $("atualizacao-achado").hidden = true;
+  $("atualizacao-travessia").hidden = true;
+  $("atualizacao-estado").textContent = DEPOIS_DA_TRAVESSIA[escolha];
+}
+
+$("travessia-cancelar").addEventListener("click", () => escolherNaTravessia("cancelar"));
+$("travessia-adiar").addEventListener("click", () => escolherNaTravessia("adiar"));
+$("travessia-prosseguir").addEventListener("click", () => escolherNaTravessia("prosseguir"));
+// Apertar fora cancela, como em toda camada desta janela: cancelar é a saída
+// que não muda nada.
+fecharAoClicarFora("travessia", () => escolherNaTravessia("cancelar"));
+
+// Escape cancela, e Tab circula entre as três saídas. Em fase de captura: com a
+// confirmação aberta ela é a coisa mais de cima, e o Escape não pode fechar a
+// configuração atrás dela.
+window.addEventListener(
+  "keydown",
+  (evento) => {
+    if ($("travessia").hidden) return;
+    if (evento.key === "Escape") {
+      evento.preventDefault();
+      evento.stopPropagation();
+      escolherNaTravessia("cancelar");
+      return;
+    }
+    if (evento.key !== "Tab") return;
+    const saidas = [$("travessia-cancelar"), $("travessia-adiar"), $("travessia-prosseguir")];
+    const agora = saidas.indexOf(document.activeElement);
+    const passo = evento.shiftKey ? -1 : 1;
+    const proxima = saidas[(agora + passo + saidas.length) % saidas.length] ?? saidas[0];
+    evento.preventDefault();
+    proxima.focus();
+  },
+  true,
+);
