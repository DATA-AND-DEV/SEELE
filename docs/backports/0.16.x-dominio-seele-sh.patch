+/// O bilhete de um convite antigo aponta o ponto pelo nome anterior (`crate::encontro::PONTOS_LEGADOS`): lido, ele vira EXATAMENTE o
+/// [`crate::encontro::PONTO_PADRAO`] (o mesmo serviço), com a porta se ela veio escrita. Backport 0.16.x do domínio seele.sh.
+fn remapear_ponto_legado(ponto: &str) -> String {
+    let Ok(alvo) = separar_ponto(ponto) else {
+        return ponto.to_owned();
+    };
+    let maquina = alvo.maquina.trim_end_matches('.');
+    if !crate::encontro::PONTOS_LEGADOS.iter().any(|legado| maquina.eq_ignore_ascii_case(legado)) {
+        return ponto.to_owned();
+    }
+    if ponto.contains(':') {
+        format!("{}:{}", crate::encontro::PONTO_PADRAO, alvo.porta)
+    } else {
+        crate::encontro::PONTO_PADRAO.to_owned()
+    }
+}
