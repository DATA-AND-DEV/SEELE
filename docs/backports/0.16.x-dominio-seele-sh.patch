+    fn o_bilhete_de_um_convite_antigo_aponta_o_ponto_novo_e_so_pelo_nome_exato() {
+        for (enc, esperado) in [
+            ("encontro.seele.app.br/198.51.100.7:41234", "rendzvous.seele.sh"),
+            ("encontro.seele.app.br:8384/198.51.100.7:41234", "rendzvous.seele.sh:8384"),
+            ("encontro.seele.app.br.exemplo/198.51.100.7:41234", "encontro.seele.app.br.exemplo"),
+            ("encontro.exemplo:8384/198.51.100.7:41234", "encontro.exemplo:8384"),
+        ] {
+            assert_eq!(Bilhete::ler(enc).unwrap().ponto, esperado, "{enc}");
+        }
+        assert!(crate::encontro::aponta_para_a_producao("encontro.seele.app.br"), "o nome antigo saiu do guarda dos testes");
+        assert!(crate::encontro::aponta_para_a_producao("rendzvous.seele.sh:8384"));
+    }
+}
