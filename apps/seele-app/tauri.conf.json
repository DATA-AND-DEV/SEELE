{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEELE",
  "version": "0.0.0",
  "identifier": "tech.datadev.seele",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "SEELE · Entry Plug",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Voz e texto auto-hospedados",
    "longDescription": "Cliente desktop do SEELE. Conversa por voz e texto num servidor que você mesmo hospeda.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DATA-AND-DEV/SEELE/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFMzRCNjhFNTkyMjBENDkKUldSSkRTSlpqclkwdnFQZGdLMnhhbUkzeEN1Vi8zb2NFWFBQN1EyMnI3QVZXUG9PVWZVc21BclcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
