<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    O manifesto do instalador.

    `requireAdministrator` porque este instalador escreve em `Program Files` e em
    `HKLM`, e cria uma regra de firewall de entrada. Sem elevação as três coisas
    falham — e falham **depois** de a janela abrir, no meio da instalação, que é
    o pior momento para descobrir. Com o manifesto, o Windows pergunta uma vez,
    antes de qualquer coisa aparecer.

    `uiAccess="false"` porque não pedimos nada além do normal: `true` exige
    assinatura e instalação em pasta protegida.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Por monitor, na segunda versão. O código também pede isto em `janela.rs`, e a
    repetição é de propósito: o que vale é o que chegar primeiro, e o manifesto
    chega antes de a primeira janela existir. Sem ele há um instante em que o
    processo ainda não é ciente de dpi, e uma janela criada nesse instante nasce
    esticada.
  -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!--
    Windows 7 a 11, declarados. Sem esta lista o Windows finge ser o 8 para o
    processo, e as APIs de versão respondem errado — que é justamente o que a
    conferência de «Windows velho demais» vai perguntar.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}" />
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}" />
    </application>
  </compatibility>
</assembly>
